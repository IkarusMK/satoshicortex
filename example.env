# SatoshiCortex — base settings.
#
# Copy this file to ".env". This is everything you set by hand: all the rest is
# configured comfortably in the web interface after the start — RPC passwords,
# directory structure, Bitcoin and Lightning options are handled by the setup
# wizard itself.

TZ=Europe/Berlin

# Which identity the services run under, and who owns the files they create.
# 1000:1000 fits most Linux systems.
# CAREFUL ON NAS SYSTEMS: UGREEN (UGOS) and Synology keep users in the group
# "users" with GID 10 -- there, PGID=10 belongs here. Otherwise the block data
# ends up owned by a group the device does not have.
PUID=1000
PGID=1000

# ---------------------------------------------------------------- Versions
# Why versions are pinned here at all, instead of always taking the newest:
# there is a wallet on this machine. An image that silently swaps itself out on
# the next restart is exactly what you do not want there -- and with LND a
# database migration cannot even be undone, a downgrade is simply refused.
#
# Pinned does NOT mean frozen. Renovate watches these four lines and opens a
# proposal as soon as something new appears (see renovate.json). Updating is
# then: raise the number here, "docker compose up -d". You always know which
# version is running, and you decide when.
#
# For reassurance: an older Bitcoin Core version is not thrown off the network.
# The consensus rules are backwards compatible; nodes running versions several
# years old still connect. Staying current is still worth it -- because of
# security holes, and because new analyses need new RPCs.
#
# IMPORTANT about the two third-party versions below: the images are BUILT from
# the official release, not pulled from someone else's images -- and the
# Dockerfile verifies the signatures against pinned publisher keys. If you enter
# a version here that we have not published yet, "docker compose pull" finds
# nothing.
#
# You do not have to wait for that, though: the build checks daily on its own
# whether Core or LND have a new release, and publishes the image then. Nobody
# has to touch the project for it. If you do hit "manifest unknown" once --
# because the release is only a few hours old, say -- set the number back and
# pull it the next day.

# renovate: datasource=github-releases depName=bitcoin/bitcoin extractVersion=^v(?<version>.*)$
BITCOIN_VERSION=31.1
# renovate: datasource=github-releases depName=lightningnetwork/lnd
LND_VERSION=v0.21.3-beta

# Our own images. "latest" is right here: they carry no third-party binaries,
# and pinning a fixed number works at any time if you want to hold
# on to a particular version.
SATCORTEX_VERSION=latest
TOR_VERSION=latest


# ---------------------------------------------------------------- Storage
# Two mount points, nothing more is needed. SatoshiCortex creates the structure
# below them itself.
#
#   BULK  large and slow is perfectly fine (HDD).
#         Needs ~1 TB and grows by ~85 GB a year.
#   FAST  small but quick (SSD). ~25 GB is enough.
#
# CAREFUL: the two defaults below sit in the same folder and therefore on the
# SAME disk. For a first try that is fine -- but on a NAS with both a hard disk
# AND an SSD you give away the whole split, and the ~840 GB block chain may end
# up on the small fast disk. On a NAS it looks more like this:
#
#   DATA_BULK=/volume1/docker/bitcoin/bulk    # large hard disk
#   DATA_FAST=/volume2/docker/bitcoin/fast    # SSD
#
# Which volume is which is shown in your NAS storage manager. Only one disk?
# Then point both at the same folder -- it runs, it just takes longer.
DATA_BULK=./data/bulk
DATA_FAST=./data/fast

# ------------------------------------------------------- Encryption
# The interface runs over HTTP by default. That is deliberate: a self-signed
# certificate would raise a security warning on the very first visit -- exactly
# where you type your password -- and trains people to click such warnings away.
#
# On your own home network HTTP is defensible. Where other devices share that
# network (WG, guest WiFi, IoT), the login password travels in the clear.
#
# If you have certificates -- from a reverse proxy or from Let's Encrypt --
# mount them here. The paths are INSIDE the container, so below /fast:
#   TLS_CERT=/fast/config/tls/fullchain.pem
#   TLS_KEY=/fast/config/tls/privkey.pem
# They belong together; if only one is set, the interface keeps running
# unencrypted and says so at startup.
TLS_CERT=
TLS_KEY=

# ---------------------------------------------------------------- Ports
# Which interface the web UI listens on.
# 0.0.0.0 means: reachable from your whole home network. That is the default,
# otherwise you could only reach it from the machine itself. If you put
# everything behind a reverse proxy, set 127.0.0.1 here.
# The Bitcoin port is NOT affected by this -- it always listens on all
# interfaces, which is the whole point of taking part.
LAN_BIND=0.0.0.0

# The web interface. This is where you land after the start.
#
# NOT 4080: that is the default port of the mempool.space UI, and people who
# build themselves a Bitcoin node often already run it. That is exactly what
# happened on the first rollout -- the container could not bind the port, and
# the NAS UI displayed the mapping anyway. The error then looked like broken
# software.
#
# If a port is taken, this reveals it:  sudo ss -tlnp | grep :3333
WEBUI_PORT=3333

# These two belong forwarded in your router (IPv4 and IPv6), so that your node
# takes part in the network instead of only watching. The wizard checks this for
# you and explains what it achieves.
BITCOIN_P2P_PORT=8333
LIGHTNING_P2P_PORT=9735

# Your watchtower, which guards OTHER people's channels. With Tor switched on
# it needs no forward at all: Tor offers it under its own onion address, and
# that address shows up under Channels. Forward this port (IPv4 and IPv6) only
# if you also want to offer the tower over clearnet -- and it is announced
# that way only in "Tor and clearnet" mode, never in "Tor only".
WATCHTOWER_PORT=9911

# ---------------------------------------------------------------- Container network
# The containers get FIXED addresses in their own network: <prefix>.10 for the
# app, .11 bitcoind, .12 LND, .13 Tor. Tor forwards connections that arrive at
# your onion addresses to exactly those addresses -- that is how your node is
# reachable over Tor without any router forward.
#
# Why fixed: Tor runs in its own container. A name such as "lnd" would be
# resolved only once when Tor starts; after an update LND may get a different
# address, and the onion service would point into the void.
#
# Only change this if "docker compose up" reports
#   Pool overlaps with other one on this address space
# -- then another network on your machine already uses this range. Pick any
# other private /24 that is free, e.g. 10.84.33. Only the first three parts go
# here.
NETWORK_PREFIX=10.83.33

# Wallets such as Sparrow connect straight to Bitcoin Core -- Settings ->
# Server -> Bitcoin Core. An Electrum server is not needed for that, and with
# txindex you even gain functions that would otherwise require one. That is why
# there is no ELECTRUM_PORT here any more.

# ---------------------------------------------------------------- Sign-in
# You create your own account on the first visit. There is nothing else to set
# here.
#
# ---- Sign in through your own identity provider (optional) ----------------
# Pocket ID, Authentik, Keycloak -- anything that speaks OpenID Connect.
#
# These four values were once here without any sign-in path behind them; they
# were rightly removed back then. Now the path exists.
#
# There is deliberately NO separate ON/OFF switch: what is filled in completely
# is what is switched on. A switch you can flip without anything changing was
# precisely the old mistake.
#
# Two things that belong with this:
#
#  * WHO gets in is decided by your identity provider, not by SatoshiCortex. In
#    Pocket ID a new client initially lets NOBODY in -- you grant access to
#    specific groups there. A second list of names here would be a second truth
#    that drifts apart from the first.
#  * The local account remains as an EMERGENCY DOOR, but it then accepts
#    passwords only from requests that did NOT come through the reverse proxy --
#    so from your home network. From outside there really is only the identity
#    provider. For that to hold, the interface port must not be forwarded to the
#    internet; what goes out are 8333, 9735 and optionally 9911 -- nothing
#    else.
#
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URL=https://btc.example.com/api/anmeldung/oidc/callback
#
# The secret is OPTIONAL and not even provided for by Pocket ID: there are only
# public clients there, which identify themselves via PKCE instead of a shared
# secret ("token_endpoint_auth_method must be none"). Leave it empty. If your
# provider still issues one (Authentik, Keycloak), enter it here and it will be
# sent along.
# OIDC_CLIENT_SECRET=
#
# Enter the return address EXACTLY AS IT STANDS as the callback at your identity
# provider as well. It has to be publicly reachable -- the browser calls it, not
# the server.

# ---- Is there a reverse proxy in front that terminates TLS? ---------------
# Then SatoshiCortex itself speaks plain text while the browser speaks https.
# Without this switch the session cookie would lack "Secure" in exactly the
# internet-facing case -- and would therefore also be sent over plain text.
# TLS_EXTERN=true

# ---------------------------------------------------------------- Performance
# Hard ceilings. SatoshiCortex never takes more -- no matter what it is doing.
# That is deliberate: a NAS normally runs other services too, and those should
# not grind to a halt just because the chain is being verified here.
#
# WITHIN these limits the application regulates itself. During the initial setup
# the cache may be larger, afterwards it winds it back down -- you do not have
# to care about that.
#
# The default below is "balanced" and fits a NAS with 4 cores and 8 GB of RAM
# that runs other things as well.

# CAREFUL: none of these CPU values may exceed the machine's core count, or the
# container will not start at all -- Docker then only reports "range of CPUs is
# from 0.01 to X" and does not name the value it means. 2.0 runs on dual-core
# machines and above. If you have more cores, feel free to raise it.
BITCOIND_CPUS=2.0
BITCOIND_MEM=2500M
# LND needs little: it barely computes, it waits. Its memory goes almost
# entirely into the channel graph of the network.
LND_CPUS=1.0
LND_MEM=512M
APP_CPUS=1.0
APP_MEM=400M
TOR_CPUS=0.25
TOR_MEM=64M

# FRUGAL — the NAS has little headroom (2 cores, 4 GB) or many other services.
# The initial setup then takes longer, but completes reliably:
#   BITCOIND_CPUS=1.5   BITCOIND_MEM=1500M
#   LND_CPUS=0.5        LND_MEM=400M
#   APP_CPUS=0.5        APP_MEM=300M
#
# FULL POWER — the machine belongs to the node alone. Set the CPU values to your
# core count and raise the memory:
#   BITCOIND_CPUS=<cores>   BITCOIND_MEM=4000M
#   LND_CPUS=1.0            LND_MEM=768M

# ---------------------------------------------------------------- Network load
# The upload budget and the number of connections are set in the wizard -- where
# what the choice actually means is written next to it. Deliberately not here:
# those are decisions about taking part in the network, not deployment values.

# ── Wallet software on your home network ───────────────────────────────────
# The RPC interface of bitcoind. Default 127.0.0.1: only the server itself can
# reach it, for everyone else it is closed -- as it has always been.
#
# Set it to 0.0.0.0 if wallet software on your home network should use this node
# as its backend (Sparrow, including with a hardware device). It does NOT create
# a wallet inside the node; the keys stay with it. In addition, the home network
# has to be permitted in the settings -- the port alone does nothing.
RPC_BIND=127.0.0.1
BITCOIN_RPC_PORT=8332

# ── External wallets (Zeus) over VPN ───────────────────────────────────────
# LND's REST interface, for a phone that reaches your home network through
# your router's VPN (WireGuard on a FRITZ!Box, for instance). Off unless you
# set BOTH lines: then LND answers on this port on your home network. Keys for
# devices are issued in the interface under "External wallets"; without such a
# key the port grants nothing.
#
# Never forward this port in your router -- that would put LND's interface on
# the internet. Over Tor you need neither line.
# LND_REST_BIND=0.0.0.0
# LND_REST_LAN_PORT=8080
